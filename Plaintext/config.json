{
  "checkpoint": "google/bert_uncased_L-2_H-768_A-12",
  "teacher": "google/bert_uncased_L-2_H-768_A-12",
  "tokenizer": "bert-base-uncased",
  "data": "data",
  "output": "outputs",
  "sources": [
    ["bookcorpus/bookcorpus", "plain_text", 16],
    ["legacy-datasets/wikipedia", "20220301.en", 0]
